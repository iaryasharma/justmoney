<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp" /><solid android:color="#26FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="4dp" /><gradient android:type="linear" android:angle="0" android:startColor="#8B5CF6" android:endColor="#C4B5FD" /></shape></clip>
    </item>
</layer-list>
