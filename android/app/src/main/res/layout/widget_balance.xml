<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_w_bank" android:alpha="0.6" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Bank balance" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/bal_eye" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_w_eye" android:contentDescription="Hide amounts" />
    </LinearLayout>
    <TextView android:id="@+id/bal_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/bal_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open JustMoney" android:textColor="#80FFFFFF" android:textSize="11sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:id="@+id/bal_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/bal_logo1" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:contentDescription="@null" />
            <TextView android:id="@+id/bal_name1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bal_amt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bal_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/bal_logo2" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:contentDescription="@null" />
            <TextView android:id="@+id/bal_name2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bal_amt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bal_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/bal_logo3" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:contentDescription="@null" />
            <TextView android:id="@+id/bal_name3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bal_amt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
